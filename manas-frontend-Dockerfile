# Stage 1: Use a clean, small NGINX base image
FROM nginx:alpine

# Remove the default NGINX configuration file
RUN rm /etc/nginx/conf.d/default.conf

# Copy our custom NGINX configuration (the routing instructions from above)
COPY nginx.conf /etc/nginx/conf.d/

# Copy ALL your HTML, CSS, and JS files into the NGINX web root
COPY . /usr/share/nginx/html

# Tell Docker the container exposes traffic on port 80 (where NGINX is listening)
EXPOSE 80

# Default command to start the NGINX server
CMD ["nginx", "-g", "daemon off;"]